---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { SITE_TITLE } from "../../consts";
import "../../styles/masonry.css";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Photography | ${SITE_TITLE}`}
      description="A collection of my photos from around the world."
      favicon="📸"
    />
    <script is:inline>
      if ("scrollRestoration" in history) {
        history.scrollRestoration = "manual";
      }
      window.scrollTo(0, 0);
      window.addEventListener(
        "pageshow",
        () => {
          window.scrollTo(0, 0);
        },
        { once: true },
      );
      window.addEventListener(
        "load",
        () => {
          window.scrollTo(0, 0);
        },
        { once: true },
      );
    </script>
    <style is:global>
      main {
        width: calc(100% - 6rem);
        max-width: 1100px;
        margin: auto;
        padding: 6.5rem 0 3em;
      }
      .page-intro {
        width: calc(100% - 1rem);
        max-width: none;
        margin: 0 auto;
        padding: 0 0.5rem 1.5em;
      }
      .page-intro h1 {
        margin: 0 0 0.5rem;
      }
      .page-intro p {
        margin: 0;
        color: var(--text-muted);
      }
      .gallery-tabs {
        display: flex;
        justify-content: flex-start;
        gap: 1.5rem;
        width: 100%;
        max-width: none;
        margin: 0 0 1.5rem;
        padding: 0 0.5rem;
        border-bottom: 1px solid rgba(var(--gray), 20%);
      }
      .gallery-tab {
        background: none;
        border: none;
        cursor: pointer;
        padding: 0.75rem 0.25rem;
        font-family: "Roboto", sans-serif;
        font-size: 0.9rem;
        color: var(--text-muted);
        border-bottom: 2px solid transparent;
        margin-bottom: -1px;
        transition:
          color 0.2s ease,
          border-color 0.2s ease;
      }
      .gallery-tab:hover {
        color: var(--text-primary);
      }
      .gallery-tab.active {
        color: var(--accent);
        border-bottom-color: var(--accent);
      }
      .gallery-panel[hidden] {
        display: none;
      }
      .gallery-status {
        width: calc(100% - 1rem);
        padding: 0 0.5rem;
        margin: 2rem auto 0;
        color: var(--text-muted);
        font-size: 0.9rem;
      }
      .gallery-skeleton {
        width: calc(100% - 1rem);
        padding: 0 0.5rem;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
      }
      .gallery-skeleton-item {
        border-radius: 3px;
        background: linear-gradient(
          90deg,
          rgba(var(--gray), 0.08) 0%,
          rgba(var(--gray), 0.18) 50%,
          rgba(var(--gray), 0.08) 100%
        );
        background-size: 200% 100%;
        animation: shimmer 1.5s ease-in-out infinite;
      }
      [data-theme="dark"] .gallery-skeleton-item {
        background: linear-gradient(
          90deg,
          rgba(255, 255, 255, 0.04) 0%,
          rgba(255, 255, 255, 0.1) 50%,
          rgba(255, 255, 255, 0.04) 100%
        );
        background-size: 200% 100%;
      }
      @keyframes shimmer {
        0% {
          background-position: 200% 0;
        }
        100% {
          background-position: -200% 0;
        }
      }
      @media (max-width: 900px) {
        .gallery-skeleton {
          grid-template-columns: repeat(2, 1fr);
        }
      }
      @media (max-width: 720px) {
        main {
          width: calc(100% - 1.5rem);
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="page-intro">
        <h1>Photography</h1>
        <p>
          I enjoy taking photos of urban architecture, natural landscapes, and
          sometimes people.
        </p>
      </div>

      <div class="gallery-tabs" id="gallery-tabs" role="tablist"></div>

      <div id="gallery-loading">
        <div class="gallery-skeleton">
          {
            [240, 300, 200, 260, 220, 280].map((h) => (
              <div class="gallery-skeleton-item" style={`height: ${h}px`} />
            ))
          }
        </div>
      </div>

      <div id="gallery-panels"></div>
    </main>
    <Footer />
  </body>
</html>

<script>
  import type { Manifest } from "../../utils/photography";
  import {
    getImageUrl,
    getResizedImageUrl,
    getFullSizeImageUrl,
    getSrcSet,
    GALLERY_IMAGE_SIZES,
  } from "../../utils/images";
  import {
    setupMasonryGallery,
    createMasonryItem,
  } from "../../scripts/masonry";
  import { IMAGE_CDN_ORIGIN } from "../../consts";

  const BATCH_SIZE = 10;
  const MANIFEST_URL = `${IMAGE_CDN_ORIGIN}/photography/manifest.json`;

  function chunkArray<T>(arr: T[], size: number): T[][] {
    const out: T[][] = [];
    for (let i = 0; i < arr.length; i += size)
      out.push(arr.slice(i, i + size));
    return out;
  }

  function buildGalleryPanel(
    panelId: string,
    images: Array<{ path: string; uploadedAt: string }>,
    region: string,
  ): HTMLElement {
    const panel = document.createElement("div");
    panel.className = "gallery-panel";
    panel.id = panelId;
    panel.dataset.region = region;

    chunkArray(images, BATCH_SIZE).forEach((chunk) => {
      const galleryId = `masonry-${Math.random().toString(36).slice(2, 8)}`;
      const galleryEl = document.createElement("div");
      galleryEl.className = "masonry-gallery";
      galleryEl.id = galleryId;
      galleryEl.dataset.columns = "3";
      galleryEl.dataset.shuffle = "false";
      galleryEl.style.setProperty("--columns", "3");

      chunk.forEach((image, index) => {
        const cdnUrl = getImageUrl(image.path);
        galleryEl.appendChild(
          createMasonryItem(
            getFullSizeImageUrl(cdnUrl),
            getResizedImageUrl(cdnUrl),
            getSrcSet(cdnUrl),
            GALLERY_IMAGE_SIZES,
            `Photo from ${region}`,
            index,
          ),
        );
      });

      panel.appendChild(galleryEl);
    });

    return panel;
  }

  function shuffleAllGallery() {
    const panel = document.getElementById("gallery-All");
    if (!panel) return;

    const galleries = Array.from(
      panel.querySelectorAll<HTMLElement>(".masonry-gallery"),
    );
    const allItems = galleries.flatMap((gallery) =>
      Array.from(gallery.querySelectorAll<HTMLElement>(".masonry-item")),
    );

    for (let i = allItems.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [allItems[i], allItems[j]] = [allItems[j], allItems[i]];
    }

    galleries.forEach((gallery, index) => {
      gallery
        .querySelectorAll(".masonry-item")
        .forEach((item) => item.remove());

      allItems
        .slice(index * BATCH_SIZE, (index + 1) * BATCH_SIZE)
        .forEach((item, itemIndex) => {
          item.style.setProperty(
            "--delay",
            `${Math.min(itemIndex, 12) * 0.04}s`,
          );
          gallery.appendChild(item);
        });

      gallery.dispatchEvent(new CustomEvent("masonry-relayout"));
    });
  }

  function buildTabsAndPanels(manifest: Manifest) {
    const tabsEl = document.getElementById("gallery-tabs")!;
    const panelsEl = document.getElementById("gallery-panels")!;
    const regions = manifest.regions;
    const allImages = regions.flatMap((r) => r.images);

    function activateTab(region: string) {
      tabsEl.querySelectorAll<HTMLElement>(".gallery-tab").forEach((btn) => {
        const isActive = btn.dataset.region === region;
        btn.classList.toggle("active", isActive);
        btn.setAttribute("aria-selected", String(isActive));
      });

      panelsEl.querySelectorAll<HTMLElement>(".gallery-panel").forEach((p) => {
        p.hidden = p.dataset.region !== region;
      });

      if (region === "All") shuffleAllGallery();
      window.dispatchEvent(new Event("resize"));
    }

    function makeTab(label: string, region: string, active: boolean) {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "gallery-tab" + (active ? " active" : "");
      btn.dataset.region = region;
      btn.role = "tab";
      btn.setAttribute("aria-selected", String(active));
      btn.setAttribute("aria-controls", `gallery-${region}`);
      btn.textContent = label;
      btn.addEventListener("click", () => activateTab(region));
      return btn;
    }

    tabsEl.appendChild(makeTab("All", "All", true));

    const allPanel = buildGalleryPanel("gallery-All", allImages, "All");
    allPanel.dataset.region = "All";
    panelsEl.appendChild(allPanel);

    regions.forEach((region) => {
      tabsEl.appendChild(makeTab(region.id, region.id, false));

      const panel = buildGalleryPanel(
        `gallery-${region.id}`,
        region.images,
        region.id,
      );
      panel.hidden = true;
      panelsEl.appendChild(panel);
    });

    panelsEl
      .querySelectorAll<HTMLElement>(
        ".masonry-gallery:not([data-masonry-ready])",
      )
      .forEach((el) => {
        el.dataset.masonryReady = "true";
        setupMasonryGallery(el.id);
      });

    shuffleAllGallery();
  }

  async function loadGallery() {
    const tabsEl = document.getElementById("gallery-tabs");
    const panelsEl = document.getElementById("gallery-panels");
    const loadingEl = document.getElementById("gallery-loading");

    if (!tabsEl || !panelsEl) return;
    if (panelsEl.dataset.galleryReady === "true") return;
    panelsEl.dataset.galleryReady = "true";

    try {
      const res = await fetch(MANIFEST_URL);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const manifest: Manifest = await res.json();

      tabsEl.replaceChildren();
      panelsEl.replaceChildren();
      loadingEl?.remove();

      buildTabsAndPanels(manifest);
    } catch {
      panelsEl.dataset.galleryReady = "false";
      if (loadingEl) {
        loadingEl.innerHTML =
          '<p class="gallery-status">Gallery temporarily unavailable. Please try again later.</p>';
      }
    }
  }

  // Required for ClientRouter: module scripts are not re-run on soft navigations.
  document.addEventListener("astro:page-load", loadGallery);
</script>
