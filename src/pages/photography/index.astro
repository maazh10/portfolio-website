---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import MasonryGallery from "../../components/MasonryGallery.astro";
import { SITE_TITLE } from "../../consts";
import { getPhotographyImages } from "../../utils/photography";

const { images, regions } = getPhotographyImages();

const BATCH_SIZE = 10;

function chunkArray<T>(arr: T[], size: number): T[][] {
  const out: T[][] = [];
  for (let i = 0; i < arr.length; i += size) out.push(arr.slice(i, i + size));
  return out;
}

const imageChunks = chunkArray(images, BATCH_SIZE);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Photography | ${SITE_TITLE}`}
      description="A collection of my photos from around the world."
      favicon="📸"
    />
    <script is:inline>
      if ("scrollRestoration" in history) {
        history.scrollRestoration = "manual";
      }
      window.scrollTo(0, 0);
      window.addEventListener(
        "pageshow",
        () => {
          window.scrollTo(0, 0);
        },
        { once: true },
      );
      window.addEventListener(
        "load",
        () => {
          window.scrollTo(0, 0);
        },
        { once: true },
      );
    </script>
    <style>
      main {
        width: calc(100% - 6rem);
        max-width: 1100px;
        margin: auto;
        padding: 6.5rem 0 3em;
      }
      .page-intro {
        width: calc(100% - 1rem);
        max-width: none;
        margin: 0 auto;
        padding: 0 0.5rem 1.5em;
      }
      .page-intro h1 {
        margin: 0 0 0.5rem;
      }
      .page-intro p {
        margin: 0;
        color: var(--text-muted);
      }
      .gallery-tabs {
        display: flex;
        justify-content: flex-start;
        gap: 1.5rem;
        width: 100%;
        max-width: none;
        margin: 0 0 1.5rem;
        padding: 0 0.5rem;
        border-bottom: 1px solid rgba(var(--gray), 20%);
      }
      .gallery-tab {
        background: none;
        border: none;
        cursor: pointer;
        padding: 0.75rem 0.25rem;
        font-family: "Roboto", sans-serif;
        font-size: 0.9rem;
        color: var(--text-muted);
        border-bottom: 2px solid transparent;
        margin-bottom: -1px;
        transition:
          color 0.2s ease,
          border-color 0.2s ease;
      }
      .gallery-tab:hover {
        color: var(--text-primary);
      }
      .gallery-tab.active {
        color: var(--accent);
        border-bottom-color: var(--accent);
      }
      .gallery-panel[hidden] {
        display: none;
      }
      @media (max-width: 720px) {
        main {
          width: calc(100% - 1.5rem);
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="page-intro">
        <h1>Photography</h1>
        <p>
          I enjoy taking photos of urban architecture, natural landscapes, and
          sometimes people.
        </p>
      </div>
      <div class="gallery-tabs" role="tablist">
        {
          ["All", ...regions].map((region, index) => (
            <button
              type="button"
              class="gallery-tab"
              class:list={{ active: index === 0 }}
              data-region={region}
              role="tab"
              aria-selected={index === 0}
              aria-controls={`gallery-${region}`}
            >
              {region}
            </button>
          ))
        }
      </div>
      <div class="gallery-panel" id="gallery-All" data-region="All">
        {
          imageChunks.map((chunk) => (
            <MasonryGallery images={chunk} columns={3} />
          ))
        }
      </div>
      {
        regions.map((region) => {
          const regionChunks = chunkArray(
            images.filter((image) => image.region === region),
            BATCH_SIZE,
          );
          return (
            <div
              class="gallery-panel"
              id={`gallery-${region}`}
              data-region={region}
              hidden
            >
              {regionChunks.map((chunk) => (
                <MasonryGallery images={chunk} columns={3} />
              ))}
            </div>
          );
        })
      }
    </main>
    <Footer />
  </body>
</html>

<script define:vars={{ batchSize: BATCH_SIZE }}>
  const tabs = Array.from(document.querySelectorAll(".gallery-tab"));
  const panels = Array.from(document.querySelectorAll(".gallery-panel"));

  function shuffleAllGallery() {
    const panel = document.getElementById("gallery-All");
    if (!panel) return;

    const galleries = Array.from(panel.querySelectorAll(".masonry-gallery"));
    const allItems = galleries.flatMap((gallery) =>
      Array.from(gallery.querySelectorAll(".masonry-item")),
    );

    for (let i = allItems.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [allItems[i], allItems[j]] = [allItems[j], allItems[i]];
    }

    galleries.forEach((gallery, index) => {
      gallery
        .querySelectorAll(".masonry-item")
        .forEach((item) => item.remove());

      const chunk = allItems.slice(index * batchSize, (index + 1) * batchSize);

      chunk.forEach((item, itemIndex) => {
        item.style.setProperty("--delay", `${Math.min(itemIndex, 12) * 0.04}s`);
        gallery.appendChild(item);
      });

      gallery.dispatchEvent(new CustomEvent("masonry-relayout"));
    });
  }

  shuffleAllGallery();
  window.scrollTo(0, 0);

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const region = tab.dataset.region || "All";

      tabs.forEach((button) => {
        const isActive = button === tab;
        button.classList.toggle("active", isActive);
        button.setAttribute("aria-selected", String(isActive));
      });

      panels.forEach((panel) => {
        panel.hidden = panel.dataset.region !== region;
      });

      if (region === "All") {
        shuffleAllGallery();
      }

      window.dispatchEvent(new Event("resize"));
    });
  });
</script>
