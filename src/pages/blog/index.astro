---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import { getImageUrl, getResizedImageUrl } from "../../utils/images";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title=`Blog | ${SITE_TITLE}`
      description={SITE_DESCRIPTION}
      favicon="📝"
    />
    <style>
      main {
        width: 960px;
        max-width: calc(100% - 2em);
        margin: auto;
        padding: 6.5rem 1em 3em;
      }
      .page-intro {
        padding: 0 0 1.5em;
        margin-bottom: 1.5em;
        border-bottom: 1px solid rgba(var(--gray), 20%);
      }
      .page-intro h1 {
        margin: 0 0 0.5rem;
      }
      .page-intro p {
        margin: 0;
        color: var(--text-muted);
      }
      ul {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2rem;
        list-style-type: none;
        margin: 0;
        padding: 0;
      }
      ul li {
        display: flex;
        flex-direction: column;
      }
      ul li * {
        text-decoration: none;
        transition: 0.2s ease;
      }
      ul li {
        width: 100%;
        text-align: center;
      }
      ul li img {
        margin-bottom: 0.5rem;
        border-radius: 12px;
        width: 100%;
        aspect-ratio: 16/9;
        object-fit: cover;
        object-position: center;
      }
      ul li a {
        display: block;
      }
      .title {
        margin: 0;
        margin-bottom: 0.7rem;
        color: var(--text-secondary);
        line-height: 1.4;
      }
      .date {
        margin: 0;
        color: var(--text-muted);
      }
      ul li a:hover h2,
      ul li a:hover .date {
        color: var(--accent);
      }
      ul a:hover img {
        box-shadow: var(--box-shadow);
      }
      @media (max-width: 720px) {
        ul {
          grid-template-columns: 1fr;
          gap: 2rem;
        }
        ul li {
          text-align: center;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="page-intro">
        <h1>Blog</h1>
        <p>Travel photo blogs and whatever else is on my mind.</p>
      </div>
      <section>
        <ul>
          {
            posts.map((post) => (
              <li>
                <a href={`/blog/${post.id}/`}>
                  <img
                    width={720}
                    height={360}
                    src={getResizedImageUrl(
                      getImageUrl(post.data.heroImage),
                      600,
                      75,
                    )}
                    alt=""
                  />
                  <h2 class="title">
                    {post.data.type === "photo" ? "📸 " : "📝 "}
                    {post.data.title}
                  </h2>
                  <p class="date">
                    <FormattedDate date={post.data.pubDate} />
                  </p>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </main>
    <Footer />
  </body>
</html>
