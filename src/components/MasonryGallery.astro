---
import {
  getResizedImageUrl,
  getFullSizeImageUrl,
  getSrcSet,
  GALLERY_IMAGE_SIZES,
} from "../utils/images";

interface Props {
  images: Array<{
    src: string;
    alt: string;
    width?: number;
    height?: number;
  }>;
  columns?: number;
  shuffle?: boolean;
}

const { images, columns = 3, shuffle = false } = Astro.props;
const galleryId = `masonry-${Math.random().toString(36).slice(2, 8)}`;
const skeletonHeights = [200, 260, 220, 300, 240, 280, 210, 270, 230, 250];
---

<div
  class="masonry-gallery"
  id={galleryId}
  data-columns={columns}
  data-shuffle={String(shuffle)}
  style={`--columns: ${columns}`}
>
  {
    images.map((image, index) => (
      <a
        href={getFullSizeImageUrl(image.src)}
        target="_blank"
        rel="noopener noreferrer"
        class="masonry-item"
        data-original-index={index}
        style={`--delay: ${Math.min(index, 12) * 0.04}s; ${image.width && image.height ? `--skeleton-aspect-ratio: ${image.width} / ${image.height}` : `--skeleton-height: ${skeletonHeights[index % skeletonHeights.length]}px`}`}
      >
        <div class="skeleton" aria-hidden="true" />
        <img
          data-src={getResizedImageUrl(image.src)}
          data-srcset={getSrcSet(image.src)}
          sizes={GALLERY_IMAGE_SIZES}
          alt={image.alt}
          decoding="async"
        />
      </a>
    ))
  }
</div>

<style is:global>
  @import "../styles/masonry.css";
</style>

<script>
  import { setupMasonryGallery } from "../scripts/masonry";

  function initNewGalleries() {
    document
      .querySelectorAll<HTMLElement>(".masonry-gallery:not([data-masonry-ready])")
      .forEach((el) => {
        el.dataset.masonryReady = "true";
        setupMasonryGallery(el.id);
      });
  }

  initNewGalleries();
  document.addEventListener("astro:after-swap", initNewGalleries);
</script>
