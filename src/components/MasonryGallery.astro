---
import {
  getResizedImageUrl,
  getFullSizeImageUrl,
  getSrcSet,
  GALLERY_IMAGE_SIZES,
} from "../utils/images";

interface Props {
  images: Array<{
    src: string;
    alt: string;
  }>;
  columns?: number;
  shuffle?: boolean;
}

const { images, columns = 3, shuffle = false } = Astro.props;
const galleryId = `masonry-${Math.random().toString(36).slice(2, 8)}`;
const skeletonHeights = [200, 260, 220, 300, 240, 280, 210, 270, 230, 250];
---

<div class="masonry-gallery" id={galleryId} style={`--columns: ${columns}`}>
  {
    images.map((image, index) => (
      <a
        href={getFullSizeImageUrl(image.src)}
        target="_blank"
        rel="noopener noreferrer"
        class="masonry-item"
        data-original-index={index}
        style={`--delay: ${Math.min(index, 12) * 0.04}s; --skeleton-height: ${skeletonHeights[index % skeletonHeights.length]}px`}
      >
        <div class="skeleton" aria-hidden="true" />
        <img
          data-src={getResizedImageUrl(image.src)}
          data-srcset={getSrcSet(image.src)}
          sizes={GALLERY_IMAGE_SIZES}
          alt={image.alt}
          decoding="async"
        />
      </a>
    ))
  }
</div>

<style>
  .masonry-gallery {
    position: relative;
    width: calc(100% - 1rem);
    max-width: none;
    padding: 0 0.5rem;
    margin: 0 auto;
    min-height: 120px;
  }

  .masonry-item {
    position: absolute;
    display: block;
    overflow: hidden;
    border-radius: 3px;
    cursor: pointer;
    opacity: 0;
    transition:
      transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      filter 0.4s ease;
  }

  .masonry-item.loading,
  .masonry-item.visible {
    opacity: 1;
  }

  .skeleton {
    width: 100%;
    height: var(--skeleton-height, 240px);
    border-radius: 3px;
    background: linear-gradient(
      90deg,
      rgba(var(--gray), 0.08) 0%,
      rgba(var(--gray), 0.18) 50%,
      rgba(var(--gray), 0.08) 100%
    );
    background-size: 200% 100%;
    animation: shimmer 1.5s ease-in-out infinite;
  }

  [data-theme="dark"] .skeleton {
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.04) 0%,
      rgba(255, 255, 255, 0.1) 50%,
      rgba(255, 255, 255, 0.04) 100%
    );
    background-size: 200% 100%;
  }

  @keyframes shimmer {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  .masonry-item.loading img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
  }

  .masonry-item.visible .skeleton {
    display: none;
  }

  .masonry-item.visible {
    animation: fadeIn 0.5s ease-out forwards;
    animation-delay: var(--delay, 0s);
  }

  .masonry-item.filtered-out {
    display: none;
  }

  .masonry-item img {
    width: 100%;
    height: auto;
    display: block;
    filter: brightness(0.97);
    transition:
      opacity 0.35s ease,
      transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      filter 0.4s ease;
  }

  .masonry-item:hover img {
    transform: scale(1.03);
    filter: brightness(1.03);
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script define:vars={{ galleryId, defaultColumns: columns, shuffle }}>
  (function () {
    let resizeTimer = null;
    let resizeHandler = null;
    let loadComplete = false;

    function startImageLoad(img) {
      if (!img || img.src) return;

      const src = img.dataset.src;
      if (!src) return;

      img.src = src;

      const srcset = img.dataset.srcset;
      if (srcset) {
        img.srcset = srcset;
      }
    }

    function relayout() {
      const gallery = document.getElementById(galleryId);
      if (!gallery) return;

      gallery.querySelectorAll(".masonry-item").forEach((item) => {
        const img = item.querySelector("img");
        if (
          !item.classList.contains("visible") &&
          img?.complete &&
          img.naturalWidth > 0
        ) {
          item.classList.remove("loading");
          item.classList.add("visible");
        }
      });

      layout();
    }

    function shuffleItems() {
      const gallery = document.getElementById(galleryId);
      if (!gallery) return;

      const items = Array.from(gallery.querySelectorAll(".masonry-item"));
      for (let i = items.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [items[i], items[j]] = [items[j], items[i]];
      }

      items.forEach((item, index) => {
        gallery.appendChild(item);
        item.style.setProperty("--delay", `${Math.min(index, 12) * 0.04}s`);
      });

      layout();
    }

    function getColumnCount() {
      const w = window.innerWidth;
      if (w <= 900) return 2;
      return defaultColumns;
    }

    function layout() {
      const gallery = document.getElementById(galleryId);
      if (!gallery) return;

      const items = Array.from(
        gallery.querySelectorAll(".masonry-item:not(.filtered-out)"),
      );
      const gap = window.innerWidth <= 900 ? 8 : 12;
      const cols = getColumnCount();
      const totalWidth = gallery.clientWidth;
      const colWidth = (totalWidth - gap * (cols - 1)) / cols;

      const colHeights = Array(cols).fill(0);
      const colLastItems = Array(cols).fill(null);

      items.forEach((item) => {
        item.style.height = "";
        const img = item.querySelector("img");
        if (img) {
          img.style.height = "";
          img.style.objectFit = "";
          img.style.objectPosition = "";
        }
      });

      items.forEach((item) => {
        const minHeight = Math.min(...colHeights);
        const colIndex = colHeights.indexOf(minHeight);

        const x = colIndex * (colWidth + gap);
        const y = colHeights[colIndex];

        item.style.width = `${colWidth}px`;
        item.style.left = `${x}px`;
        item.style.top = `${y}px`;

        colHeights[colIndex] += item.offsetHeight + gap;
        colLastItems[colIndex] = item;
      });

      if (!items.length) {
        gallery.style.height = "0";
        return;
      }

      const maxH = Math.max(...colHeights);
      gallery.style.height = `${maxH}px`;

      if (!loadComplete) {
        const currentMin = parseInt(gallery.style.minHeight, 10) || 0;
        gallery.style.minHeight = `${Math.max(maxH, currentMin)}px`;
      }

      colLastItems.forEach((item, col) => {
        if (!item) return;
        const shortfall = maxH - colHeights[col];
        if (shortfall <= 0) return;

        item.style.height = `${item.offsetHeight + shortfall}px`;
        const img = item.querySelector("img");
        if (img) {
          img.style.height = "100%";
          img.style.objectFit = "cover";
          img.style.objectPosition = "center";
        }
      });
    }

    function init() {
      const gallery = document.getElementById(galleryId);
      if (!gallery) return;

      if (shuffle) {
        shuffleItems();
      }

      const items = Array.from(gallery.querySelectorAll(".masonry-item"));
      const images = items.map((item) => item.querySelector("img"));

      items.forEach((item) => {
        item.classList.remove("visible");
        item.classList.add("loading");
      });

      layout();
      images.forEach((img) => startImageLoad(img));

      let loaded = 0;
      const total = images.length;

      function onLoad(item) {
        loaded++;
        item.classList.remove("loading");
        item.classList.add("visible");
        layout();

        if (loaded === total) {
          loadComplete = true;
          gallery.style.minHeight = "";
        }
      }

      images.forEach((img, index) => {
        const item = items[index];

        if (img.complete && img.naturalWidth > 0) {
          onLoad(item);
        } else {
          img.addEventListener("load", () => onLoad(item), { once: true });
          img.addEventListener("error", () => onLoad(item), { once: true });
        }
      });

      if (resizeHandler) {
        window.removeEventListener("resize", resizeHandler);
      }
      resizeHandler = () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(layout, 100);
      };
      window.addEventListener("resize", resizeHandler);
    }

    function scheduleInit() {
      const gallery = document.getElementById(galleryId);
      if (!gallery) return;

      const io = new IntersectionObserver(
        (entries) => {
          if (entries[0].isIntersecting) {
            io.disconnect();
            init();
          }
        },
        { rootMargin: "200px 0px" },
      );

      io.observe(gallery);
    }

    if (shuffle) {
      const registerShuffleListener = () => {
        const gallery = document.getElementById(galleryId);
        gallery?.addEventListener("masonry-shuffle", shuffleItems);
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", registerShuffleListener);
      } else {
        registerShuffleListener();
      }
    }

    const registerRelayoutListener = () => {
      const gallery = document.getElementById(galleryId);
      gallery?.addEventListener("masonry-relayout", relayout);
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", registerRelayoutListener);
    } else {
      registerRelayoutListener();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", scheduleInit);
    } else {
      scheduleInit();
    }

    document.addEventListener("astro:after-swap", () => {
      if (document.getElementById(galleryId)) {
        scheduleInit();
      }
    });
  })();
</script>
