---
import {
  getResizedImageUrl,
  getFullSizeImageUrl,
  getSrcSet,
  GALLERY_IMAGE_SIZES,
} from "../utils/images";

interface Props {
  images: Array<{
    src: string;
    alt: string;
    region?: string;
  }>;
  columns?: number;
  tabs?: string[];
}

const { images, columns = 3, tabs } = Astro.props;
const galleryId = `masonry-${Math.random().toString(36).slice(2, 8)}`;
const hasTabs = Boolean(tabs && tabs.length > 0);
const tabOptions = hasTabs ? ["All", ...tabs!] : [];
---

{
  hasTabs && (
    <div class="gallery-tabs" role="tablist">
      {tabOptions.map((tab, index) => (
        <button
          type="button"
          class="gallery-tab"
          class:list={{ active: index === 0 }}
          data-region={tab}
          role="tab"
          aria-selected={index === 0}
        >
          {tab}
        </button>
      ))}
    </div>
  )
}

<div class="masonry-gallery" id={galleryId} style={`--columns: ${columns}`}>
  <div class="gallery-loading" id={`loading-${galleryId}`}>
    <div class="spinner"></div>
  </div>
  {
    images.map((image, index) => (
      <a
        href={getFullSizeImageUrl(image.src)}
        target="_blank"
        rel="noopener noreferrer"
        class="masonry-item"
        data-region={image.region}
        data-original-index={index}
        style={`--delay: ${Math.min(index, 12) * 0.04}s`}
      >
        <img
          src={getResizedImageUrl(image.src)}
          srcset={getSrcSet(image.src)}
          sizes={GALLERY_IMAGE_SIZES}
          alt={image.alt}
          loading="lazy"
          decoding="async"
        />
      </a>
    ))
  }
</div>

<style>
  .gallery-tabs {
    display: flex;
    justify-content: flex-start;
    gap: 1.5rem;
    width: 100%;
    max-width: none;
    margin: 0 0 1.5rem;
    padding: 0;
    border-bottom: 1px solid rgba(var(--gray), 20%);
  }

  .gallery-tab {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.75rem 0.25rem;
    font-family: "Roboto", sans-serif;
    font-size: 0.9rem;
    color: var(--text-muted);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .gallery-tab:hover {
    color: var(--text-primary);
  }

  .gallery-tab.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .masonry-gallery {
    position: relative;
    width: calc(100% - 1rem);
    max-width: none;
    padding: 2rem 0.5rem;
    margin: 0 auto;
  }

  .gallery-loading {
    position: absolute;
    top: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
    opacity: 1;
    transition: opacity 0.3s ease;
  }

  .gallery-loading.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .spinner {
    width: 48px;
    height: 48px;
    border: 3px solid rgba(var(--gray), 0.1);
    border-top: 3px solid var(--accent);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  [data-theme="dark"] .spinner {
    border: 3px solid rgba(255, 255, 255, 0.1);
    border-top: 3px solid var(--accent);
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .masonry-item {
    position: absolute;
    display: block;
    overflow: hidden;
    border-radius: 3px;
    cursor: pointer;
    opacity: 0;
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                filter 0.4s ease;
  }

  .masonry-item.visible {
    animation: fadeIn 0.5s ease-out forwards;
    animation-delay: var(--delay, 0s);
  }

  .masonry-item.filtered-out {
    display: none;
  }

  .masonry-item img {
    width: 100%;
    height: auto;
    display: block;
    filter: brightness(0.97);
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                filter 0.4s ease;
  }

  .masonry-item:hover img {
    transform: scale(1.03);
    filter: brightness(1.03);
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script define:vars={{ galleryId, defaultColumns: columns }}>
  function getColumnCount() {
    const w = window.innerWidth;
    if (w <= 900) return 2;
    return defaultColumns;
  }

  function layout() {
    const gallery = document.getElementById(galleryId);
    if (!gallery) return;

    const items = Array.from(
      gallery.querySelectorAll(".masonry-item:not(.filtered-out)"),
    );
    const gap = window.innerWidth <= 900 ? 8 : 12;
    const cols = getColumnCount();
    const totalWidth = gallery.clientWidth;
    const colWidth = (totalWidth - gap * (cols - 1)) / cols;

    const colHeights = Array(cols).fill(0);

    items.forEach((item) => {
      const minHeight = Math.min(...colHeights);
      const colIndex = colHeights.indexOf(minHeight);

      const x = colIndex * (colWidth + gap);
      const y = colHeights[colIndex];

      item.style.width = `${colWidth}px`;
      item.style.left = `${x}px`;
      item.style.top = `${y}px`;

      colHeights[colIndex] += item.offsetHeight + gap;
    });

    gallery.style.height = items.length ? `${Math.max(...colHeights)}px` : "0";
  }

  function shuffleArray(items) {
    const shuffled = [...items];
    for (let i = shuffled.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
    }
    return shuffled;
  }

  function reorderItemsForRegion(region) {
    const gallery = document.getElementById(galleryId);
    if (!gallery) return;

    const items = Array.from(gallery.querySelectorAll(".masonry-item"));
    if (!items.length) return;

    const orderedItems = items.map((item, index) => {
      if (!item.dataset.originalIndex) {
        item.dataset.originalIndex = String(index);
      }
      return item;
    });

    if (region === "All") {
      const visibleItems = orderedItems.filter(
        (item) => !item.classList.contains("filtered-out"),
      );
      const hiddenItems = orderedItems.filter((item) =>
        item.classList.contains("filtered-out"),
      );
      gallery.replaceChildren(...shuffleArray(visibleItems), ...hiddenItems);
      return;
    }

    gallery.replaceChildren(
      ...orderedItems.sort(
        (a, b) =>
          Number(a.dataset.originalIndex) - Number(b.dataset.originalIndex),
      ),
    );
  }

  function initTabs() {
    const gallery = document.getElementById(galleryId);
    const tabsContainer = gallery?.previousElementSibling;
    if (!gallery || !tabsContainer?.classList.contains("gallery-tabs")) return;

    const tabButtons = Array.from(tabsContainer.querySelectorAll(".gallery-tab"));
    const items = Array.from(gallery.querySelectorAll(".masonry-item"));

    const updateActiveRegion = (region) => {
      tabButtons.forEach((btn) => {
        const isActive = btn.dataset.region === region;
        btn.classList.toggle("active", isActive);
        btn.setAttribute("aria-selected", String(isActive));
      });

      items.forEach((item) => {
        const matches = region === "All" || item.dataset.region === region;
        item.classList.toggle("filtered-out", !matches);
      });

      reorderItemsForRegion(region);
      layout();
    };

    const activeTab = tabButtons.find((button) => button.classList.contains("active")) ?? tabButtons[0];
    if (activeTab) {
      updateActiveRegion(activeTab.dataset.region || "All");
    }

    tabButtons.forEach((button) => {
      button.addEventListener("click", () => {
        updateActiveRegion(button.dataset.region || "All");
      });
    });
  }

  function hideLoadingIndicator() {
    const loadingIndicator = document.getElementById(`loading-${galleryId}`);
    loadingIndicator?.classList.add("hidden");
  }

  function init() {
    const gallery = document.getElementById(galleryId);
    if (!gallery) return;

    const items = Array.from(gallery.querySelectorAll(".masonry-item"));
    const images = items.map((item) => item.querySelector("img"));

    items.forEach((item) => item.classList.remove("visible"));
    document.getElementById(`loading-${galleryId}`)?.classList.remove("hidden");

    let loaded = 0;
    const total = images.length;
    let spinnerHidden = false;

    function onLoad(item) {
      loaded++;
      item.classList.add("visible");
      layout();

      if (!spinnerHidden) {
        spinnerHidden = true;
        hideLoadingIndicator();
      }
    }

    images.forEach((img, index) => {
      const item = items[index];

      if (img.complete && img.naturalWidth > 0) {
        onLoad(item);
      } else {
        img.addEventListener("load", () => onLoad(item), { once: true });
        img.addEventListener("error", () => onLoad(item), { once: true });
      }
    });

    if (loaded === total) {
      hideLoadingIndicator();
    }

    let resizeTimer;
    const resizeHandler = () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(layout, 100);
    };
    window.addEventListener("resize", resizeHandler);

    return () => {
      window.removeEventListener("resize", resizeHandler);
    };
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      init();
      initTabs();
    });
  } else {
    init();
    initTabs();
  }

  document.addEventListener("astro:after-swap", () => {
    const gallery = document.getElementById(galleryId);
    if (gallery) {
      init();
      initTabs();
    }
  });
</script>
